---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { ProjectCard } from "@/components/project-card";
import { DATA } from "@/data/resume";
---

<Layout
  title="Projects"
  description="Selected software, systems, and AI projects by Pranav Darshan."
>
  <main class="flex flex-col gap-10">
    <header class="flex flex-col gap-4">
      <a
        href="/"
        class="w-fit text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        <span aria-hidden="true">←</span> Back to home
      </a>
      <div class="flex flex-col gap-3">
        <p class="text-sm font-medium text-blue-700 dark:text-blue-300">Selected Work</p>
        <h1 class="text-3xl font-semibold leading-tight sm:text-4xl">Projects</h1>
        <p class="max-w-2xl leading-relaxed text-muted-foreground">
          A selection of projects spanning AI, cloud systems, and software engineering.
        </p>
      </div>
    </header>

    <section class="grid gap-4 sm:grid-cols-2" aria-label="Projects">
      {DATA.projects.map((project) => (
        <ProjectCard
          client:load
          title={project.title}
          href={project.href}
          description={project.description}
          dates={project.dates}
          tags={project.technologies}
          accent={project.accent}
          image={project.image}
          video={project.video}
          links={project.links}
        />
      ))}
    </section>
  </main>
</Layout>
